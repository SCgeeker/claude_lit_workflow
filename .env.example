# LLM API Keys Configuration
# Copy this file to .env and fill in your API keys

# Google Gemini (推薦用於快速生成)
GOOGLE_API_KEY=your-google-api-key-here

# OpenAI GPT (高品質輸出)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Claude (強推理能力)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Ollama (本地 LLM，需先安裝 https://ollama.com)
# 本地部署預設地址，如有變更請修改
OLLAMA_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# NVIDIA NIM (學術文獻大模型，OpenAI 相容 https://build.nvidia.com)
# slides 預設 nemotron-ultra-253b、zettel 預設 qwen3-next-thinking（可用下方變數覆寫）
NVIDIA_API_KEY=nvapi-your-key-here
# NVIDIA_SLIDES_MODEL=nvidia/llama-3.1-nemotron-ultra-253b-v1
# NVIDIA_ZETTEL_MODEL=qwen/qwen3-next-80b-a3b-thinking


# 默認LLM提供者
# 可選值: auto, ollama, google, openai, anthropic, nvidia
DEFAULT_LLM_PROVIDER=auto

# 默認模型
# Ollama: gemma2:latest, llama3, mistral
# Google: gemini-2.0-flash, gemini-2.5-flash, gemini-2.5-pro
# OpenAI: gpt-4, gpt-3.5-turbo
# Anthropic: claude-3-opus, claude-3-sonnet
# NVIDIA: nvidia/llama-3.1-nemotron-ultra-253b-v1, qwen/qwen3-next-80b-a3b-thinking
DEFAULT_MODEL=gemini-2.5-flash
