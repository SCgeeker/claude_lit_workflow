# LLM API Keys Configuration
# Copy this file to .env and fill in your API keys

# Google Gemini (推薦用於快速生成)
GOOGLE_API_KEY=your-google-api-key-here

# OpenAI GPT (高品質輸出)
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic Claude (強推理能力)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Ollama (本地 LLM，需先安裝 https://ollama.com)
# 本地部署預設地址，如有變更請修改
OLLAMA_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2

# NVIDIA NIM (學術文獻大模型，OpenAI 相容 https://build.nvidia.com)
# 預設 meta/llama-3.1-8b-instruct（實測穩定）；大模型 nemotron-253b/qwen-thinking 已失效
NVIDIA_API_KEY=nvapi-your-key-here
# NVIDIA_SLIDES_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_ZETTEL_MODEL=nvidia/nemotron-3-super-120b-a12b


# 默認LLM提供者
# 可選值: auto, ollama, google, openai, anthropic, nvidia
DEFAULT_LLM_PROVIDER=auto

# 默認模型
# Ollama: gemma2:latest, llama3, mistral
# Google: gemini-2.5-flash, gemini-2.5-pro
# OpenAI: gpt-4, gpt-3.5-turbo
# Anthropic: claude-3-opus, claude-3-sonnet
# NVIDIA: meta/llama-3.1-8b-instruct (預設), nvidia/nemotron-3-super-120b-a12b
DEFAULT_MODEL=gemini-2.5-flash


# ── 網頁服務（uv run web；部署見 deploy/README.md）──────────────────────────
# 存取金鑰：網頁 UI、QuickAdd 遠端模式、/mcp 共用。產生方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
# WEB_API_TOKEN=
# 改由反向代理（Caddy basic_auth、Cloudflare Access）負責驗證時設為 1
# WEB_TRUST_PROXY_AUTH=0
# WEB_DATA_DIR=./web_data
# WEB_MAX_UPLOAD_MB=50
# WEB_MAX_WORKERS=2
# WEB_RETENTION_DAYS=7
# WEB_MAX_CUSTOM_CHARS=2000
# WEB_DAILY_JOB_LIMIT=0
# deploy/compose.yaml 使用：服務網域（DNS 須指向主機）
# LIT_DOMAIN=lit.example.com
